# Environment for the contact function (netlify/functions/contact.mts).
# Set the real values in the Netlify UI per deploy context. Never commit a filled-in copy.

# Brevo API key, restricted to transactional emails.
BREVO_API_KEY=

# Optional. Capped at 8000 so Brevo gives up before Netlify ends the function.
BREVO_REQUEST_TIMEOUT_MS=8000

# Where messages go, and the verified Brevo sender they come from.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=

# GitHub contribution heatmap (scripts/fetch-contributions.ts, docs/adr/0006-github-contributions-at-build-time.md).
# Fine-grained token: public repositories, read-only, no permissions. Set it in Netlify as a secret for the Production
# context only (the free plan keeps the default scopes; only the build script reads it). Deploy Previews and branch
# deploys (including Dependabot pull requests) never get it and build from the committed snapshot.
# Locally it stays empty, except for a one-off `pnpm contributions:update`.
GITHUB_CONTRIBUTIONS_TOKEN=

# Journal audio (scripts/generate-audio.ts, docs/adr/0007-journal-content-and-audio.md). Local authoring only:
# `pnpm audio <slug> --generate` reads it from .env.local. Never set it in Netlify; builds do not need it.
ELEVENLABS_API_KEY=
