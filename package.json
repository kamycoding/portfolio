{
  "name": "kamycoding-portfolio",
  "version": "2.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm contributions:update && next build",
    "contributions:update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-contributions.ts",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "geist": "1.8.1",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@stylistic/eslint-plugin": "5.6.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
